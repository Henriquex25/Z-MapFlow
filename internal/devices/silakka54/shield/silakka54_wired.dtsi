// SPDX-License-Identifier: MIT
// Original Silakka54 hardware: rows GP2..6, columns GP7..12, COL2ROW;
// UART0 TX GP0 / RX GP1. See Squalius-cephalus/silakka54 firmware/keyboard.json
// and firmware/config.h. This is an independent ZMK port, not a QMK firmware.
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        /delete-property/ zephyr,console;
        /delete-property/ zephyr,shell-uart;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &silakka54_layout;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <10>;
        columns = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(5,5) RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(6,5) RC(6,4) RC(6,3) RC(6,2) RC(6,1) RC(6,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(7,5) RC(7,4) RC(7,3) RC(7,2) RC(7,1) RC(7,0)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(8,5) RC(8,4) RC(8,3) RC(8,2) RC(8,1) RC(8,0)
            RC(4,3) RC(4,4) RC(4,5)  RC(9,5) RC(9,4) RC(9,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>, <&gpio0 8 GPIO_ACTIVE_HIGH>,
                    <&gpio0 9 GPIO_ACTIVE_HIGH>, <&gpio0 10 GPIO_ACTIVE_HIGH>,
                    <&gpio0 11 GPIO_ACTIVE_HIGH>, <&gpio0 12 GPIO_ACTIVE_HIGH>;
    };

    silakka54_layout: silakka54_layout {
        compatible = "zmk,physical-layout";
        display-name = "Silakka54";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <&key_physical_attrs 100 100 0 25 0 50 75>
             , <&key_physical_attrs 100 100 100 25 0 150 75>
             , <&key_physical_attrs 100 100 200 13 0 250 63>
             , <&key_physical_attrs 100 100 300 0 0 350 50>
             , <&key_physical_attrs 100 100 400 13 0 450 63>
             , <&key_physical_attrs 100 100 500 25 0 550 75>
             , <&key_physical_attrs 100 100 1000 25 0 1050 75>
             , <&key_physical_attrs 100 100 1100 13 0 1150 63>
             , <&key_physical_attrs 100 100 1200 0 0 1250 50>
             , <&key_physical_attrs 100 100 1300 13 0 1350 63>
             , <&key_physical_attrs 100 100 1400 25 0 1450 75>
             , <&key_physical_attrs 100 100 1500 25 0 1550 75>
             , <&key_physical_attrs 100 100 0 125 0 50 175>
             , <&key_physical_attrs 100 100 100 125 0 150 175>
             , <&key_physical_attrs 100 100 200 112 0 250 162>
             , <&key_physical_attrs 100 100 300 100 0 350 150>
             , <&key_physical_attrs 100 100 400 112 0 450 162>
             , <&key_physical_attrs 100 100 500 125 0 550 175>
             , <&key_physical_attrs 100 100 1000 125 0 1050 175>
             , <&key_physical_attrs 100 100 1100 112 0 1150 162>
             , <&key_physical_attrs 100 100 1200 100 0 1250 150>
             , <&key_physical_attrs 100 100 1300 112 0 1350 162>
             , <&key_physical_attrs 100 100 1400 125 0 1450 175>
             , <&key_physical_attrs 100 100 1500 125 0 1550 175>
             , <&key_physical_attrs 100 100 0 225 0 50 275>
             , <&key_physical_attrs 100 100 100 225 0 150 275>
             , <&key_physical_attrs 100 100 200 212 0 250 262>
             , <&key_physical_attrs 100 100 300 200 0 350 250>
             , <&key_physical_attrs 100 100 400 212 0 450 262>
             , <&key_physical_attrs 100 100 500 225 0 550 275>
             , <&key_physical_attrs 100 100 1000 225 0 1050 275>
             , <&key_physical_attrs 100 100 1100 212 0 1150 262>
             , <&key_physical_attrs 100 100 1200 200 0 1250 250>
             , <&key_physical_attrs 100 100 1300 212 0 1350 262>
             , <&key_physical_attrs 100 100 1400 225 0 1450 275>
             , <&key_physical_attrs 100 100 1500 225 0 1550 275>
             , <&key_physical_attrs 100 100 0 325 0 50 375>
             , <&key_physical_attrs 100 100 100 325 0 150 375>
             , <&key_physical_attrs 100 100 200 312 0 250 362>
             , <&key_physical_attrs 100 100 300 300 0 350 350>
             , <&key_physical_attrs 100 100 400 312 0 450 362>
             , <&key_physical_attrs 100 100 500 325 0 550 375>
             , <&key_physical_attrs 100 100 1000 325 0 1050 375>
             , <&key_physical_attrs 100 100 1100 312 0 1150 362>
             , <&key_physical_attrs 100 100 1200 300 0 1250 350>
             , <&key_physical_attrs 100 100 1300 312 0 1350 362>
             , <&key_physical_attrs 100 100 1400 325 0 1450 375>
             , <&key_physical_attrs 100 100 1500 325 0 1550 375>
             , <&key_physical_attrs 100 100 312 412 0 362 462>
             , <&key_physical_attrs 100 100 425 427 1500 475 477>
             , <&key_physical_attrs 100 100 535 460 3000 585 510>
             , <&key_physical_attrs 100 100 965 460 (-3000) 1015 510>
             , <&key_physical_attrs 100 100 1075 427 (-1500) 1125 477>
             , <&key_physical_attrs 100 100 1188 412 0 1238 462>;
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
};
